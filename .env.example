# URL de la API del backend TaxiSur (sin credenciales).
# El valor real se configura en un .env local no versionado.
#
# Depende de dónde ejecutes la app:
#   - Emulador Android (AVD):  http://10.0.2.2:3001
#   - Emulador iOS / web:      http://localhost:3001
#   - Teléfono físico:         http://<IP-LAN-de-tu-PC>:3001
EXPO_PUBLIC_API_URL=

# Contacto público de ayuda (teléfono de administración), sin credenciales.
# Solo se usa para el botón "Contactar" de recuperar PIN (Linking tel:).
# Si queda vacío, la app no muestra el botón de contacto.
EXPO_PUBLIC_CONTACTO_AYUDA=
